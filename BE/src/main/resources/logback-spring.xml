<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===== DEV: 콘솔 출력 (사람이 읽기 좋은 포맷) ===== -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId}] %cyan([%logger{36}]) - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- p6spy SQL 로그 레벨 조정 -->
        <logger name="p6spy" level="INFO"/>
    </springProfile>

    <!-- ===== PROD: JSON 파일 출력 (기계가 읽기 좋은 포맷) ===== -->
    <springProfile name="prod">
        <!-- 로그 파일 저장 경로 -->
        <property name="LOG_PATH" value="/var/log/safetrip"/>

        <!-- JSON 파일 appender + 로테이션 -->
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/app.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <!-- 매일 자정 롤링, 최대 30일치 보관 -->
                <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <!-- 전체 로그 파일 용량 상한 (디스크 보호) -->
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- 기본 필드 외 커스텀 필드 추가 -->
                <customFields>{"app":"safetrip"}</customFields>
            </encoder>
        </appender>

        <!-- ERROR 이상은 별도 파일로 분리 (장애 대응 시 빠르게 찾기 위해) -->
        <appender name="ERROR_FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/error.log</file>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"safetrip"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="FILE_JSON"/>
            <appender-ref ref="ERROR_FILE_JSON"/>
        </root>
    </springProfile>

</configuration>
